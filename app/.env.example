# The `stellar` CLI loads this file, so values here reach `stellar scaffold`.

# Network from scaffold.yml to build for. Defaults to the network set with
# `stellar network use`, then `local`. A value set in your shell wins, e.g.
#   STELLAR_NETWORK=testnet npm start
# The frontend follows automatically: it reads the network from the generated
# clients in app-lib/clients.
# STELLAR_NETWORK=testnet

# Secrets referenced from scaffold.yml as ${env.NAME}, e.g. an RPC token:
# MAINNET_RPC_TOKEN=

# Prefix with "PUBLIC_" to make your own values available in frontend files.

# Arqueo: testnet configuration for smart-account-kit 0.6.0. Addresses come from
# the Protocol 27 testnet manifest (docs/deployments-protocol-27-2026-07-09.md
# in stellar/smart-account-kit). Testnet only: never point these at mainnet.
PUBLIC_RPC_URL=https://soroban-testnet.stellar.org
PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
PUBLIC_ACCOUNT_WASM_HASH=1b5f4534a76322da2ad7c745f6900857a6802b0ca79850c35a03561df997785a
PUBLIC_WEBAUTHN_VERIFIER_ADDRESS=CC7EKIHQP3TN4CARQDND6CEOY2UXLWWC2X5GHTD5NLAT7BG5GPZIOM3F
PUBLIC_ED25519_VERIFIER_ADDRESS=CAAVTMCBXEIBPR64EAASKFXERVPYFZA2JYP5A3BG6PESWEFUJX5IHKN4
PUBLIC_XLM_TOKEN_CONTRACT=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC
PUBLIC_USDC_TOKEN_CONTRACT=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
PUBLIC_THRESHOLD_POLICY_ADDRESS=CB3FATQKCIRIQOCYRUPCQ2KREQ7T4RPKS7EAEOZWPEPUKWEDRVROBCEG
PUBLIC_SPENDING_LIMIT_POLICY_ADDRESS=CABXBYJNZ7IUW4G3D6BND5YCAQF3ASSDMDAOKQQ63UYFSO7WUU2TIP5G

# Company treasury account (C...). Empty until R3 creates it. For R2 you can
# point it at any funded G... account to check the balance read.
PUBLIC_COMPANY_ACCOUNT=

# R18: version deployed with per-token spend state, used for XLM.
PUBLIC_CONTROL_POLICY_ADDRESS=CCTQZ3T7OGITLMSWRCQU5KVVHM2C6ST4JCX6ZY6C35ZU4Y2A2GFZMIT4
PUBLIC_SUPPLIERS=

# R18: Circle's USDC on Stellar testnet. Fund the local G... funding address
# from https://faucet.circle.com/; no issuer secret is used by this app.
# PUBLIC_USDC_CONTROL_POLICY_ADDRESS is the existing testnet policy deployment,
# retained for USDC so its account-level spend state survives the asset change.
PUBLIC_USDC_CONTROL_POLICY_ADDRESS=CBPCC6AT3756K43DGTRKLIZFOY5TODHZXGBJS4X4KZ64TFWUQDPEWU4L
